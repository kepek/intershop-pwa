        <camfil-header-navigation></camfil-header-navigation
        ><camfil-user-links
          ng-reflect-device-type="mobile"
          ng-reflect-next-open-level-on-mobile-nav=""
        ></camfil-user-links>
      </div>
    </nav>
  </div>
</div>
`;

