      <div class="logo-wrapper">
        <ish-lazy-content-include
          includeid="camfil.include.header.mobileLogo.content.pagelet2-Include"
          ng-reflect-include-id="camfil.include.header.mobileLo"
        ></ish-lazy-content-include>
      </div>
    </div>
    <div class="col-lg-5 col-xl-6 col-sm-12 search-container">
      <div ng-reflect-collapsed="false">
        <camfil-search-box data-testing-id="search-box-desktop"></camfil-search-box>
      </div>
    </div>
    <div class="col-3 col-md-6 col-lg-3 col-xl-3 d-flex align-items-center justify-content-end">
